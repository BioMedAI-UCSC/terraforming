        "extract.py": "import hashlib,json,subprocess,tarfile\nfrom pathlib import Path\nrecords=[json.loads(Path('/work/pr123/runtime-79fd84a7e4d8597593a66be67dedfe80c9eabe14.tar.json').read_text()),\n json.loads(Path('/work/pr123/69d6587cef02e5b17a82e28422b67aa3d5be55ad/source.json').read_text())]\nfor record in records:\n with Path(record['archive']).open('rb') as stream:assert hashlib.file_digest(stream,'sha256').hexdigest()==record['sha256']\n with tarfile.open(record['archive']) as handle:handle.extractall('/scratch',filter='fully_trusted')\nassert subprocess.check_output(['git','-C','/scratch/source','rev-parse','HEAD'],text=True).strip()=='69d6587cef02e5b17a82e28422b67aa3d5be55ad'\nprint('Verified prepared runtime and source overlay',flush=True)\n",
        "runner.py": "import concurrent.futures,hashlib,json,os,subprocess,sys,threading,time\nfrom pathlib import Path\nimport numpy as np\nsource=Path('/scratch/source');os.chdir(source)\noutput=Path('/work/pr123/69d6587cef02e5b17a82e28422b67aa3d5be55ad/gpu-probe');output.mkdir(exist_ok=True)\nenv=dict(os.environ,JAX_PLATFORMS='cuda',XLA_PYTHON_CLIENT_PREALLOCATE='false',XLA_PYTHON_CLIENT_MEM_FRACTION='.45')\nstop=threading.Event()\ndef monitor():\n with (output/'gpu.csv').open('w') as stream:\n  stream.write('timestamp, gpu, memory.used.MiB, memory.total.MiB, utilization.gpu.percent, utilization.memory.percent\\n')\n  while not stop.is_set():\n   result=subprocess.run(['nvidia-smi','--query-gpu=timestamp,index,memory.used,memory.total,utilization.gpu,utilization.memory','--format=csv,noheader,nounits'],capture_output=True,text=True)\n   stream.write(result.stdout or result.stderr);stream.flush();stop.wait(15.)\nthread=threading.Thread(target=monitor);thread.start()\ndef case(name,warmup=False):\n resolution='T42' if name=='T42' else 'T21'\n case_env=dict(env,XLA_PYTHON_CLIENT_MEM_FRACTION='.6' if resolution=='T42' else '.3')\n root=output/name\n common=[sys.executable,'scripts/run_gcm3d_ablation.py','/scratch/inputs','--config','reference',\n  '--mola-path','/scratch/inputs/mars_topo_mola16.nc','--truncation',resolution,'--layers','56',\n  '--dt','231','--chunk-sols','1','--cooldown-seconds','0','--output-dir',str(root)]\n invocations=([common+['--sols','1']] if warmup else [common+['--sols','5','--resume']] if name=='T21-resumed' else [common+['--sols','5']])\n with (output/(name+'.log')).open('a') as log:\n  for command in invocations:\n   result=subprocess.run(command,env=case_env,stdout=log,stderr=subprocess.STDOUT)\n   if result.returncode:return dict(case=name,returncode=result.returncode)\n return dict(case=name,returncode=0)\ntry:\n warmup=case('T21-resumed',warmup=True)\n print(json.dumps(dict(warmup=warmup)),flush=True)\n if warmup['returncode']:raise SystemExit(1)\n import csv\n rows=list(csv.reader((output/'gpu.csv').read_text().splitlines()[1:]))\n peak=max(float(row[2]) for row in rows if len(row)==6)\n total=max(float(row[3]) for row in rows if len(row)==6)\n # Reserve 30% for measured T21 use and 60% for the four-times-larger T42 grid.\n (output/'memory-sizing.json').write_text(json.dumps(dict(warmup_sols=1,peak_mib=peak,total_mib=total,concurrency=2,process_memory_fractions=dict(T21=.3,T42=.6)),indent=2))\n print('GPU warmup and sizing complete',flush=True)\nfinally:\n stop.set();thread.join()\n"
