        "source.py": "import hashlib,json,subprocess,tarfile\nfrom pathlib import Path\nrevision='43fc88bf8f6654ddca5b7e5400a0186a46156e9d';source=Path('/tmp/source');source.mkdir()\nfor command in (['git','init',str(source)],['git','-C',str(source),'fetch','--depth=1','https://github.com/BioMedAI-UCSC/terraforming.git',revision],['git','-C',str(source),'checkout','--detach','FETCH_HEAD']):subprocess.run(command,check=True)\nassert subprocess.check_output(['git','-C',str(source),'rev-parse','HEAD'],text=True).strip()==revision\nfor name in ('uv.lock','apps/mars-calibration/constraints.txt'):\n assert (source/name).read_bytes()==(Path('/work/source')/name).read_bytes(),name\noutput=Path('/work/pr123')/revision;output.mkdir(exist_ok=True)\narchive=output/'source.tar.gz'\nwith tarfile.open(archive,'w:gz',compresslevel=1) as handle:handle.add(source,arcname='source')\nwith archive.open('rb') as stream:digest=hashlib.file_digest(stream,'sha256').hexdigest()\nrecord=dict(revision=revision,archive=str(archive),sha256=digest)\n(output/'source.json').write_text(json.dumps(record,indent=2));print(json.dumps(record),flush=True)\n"
