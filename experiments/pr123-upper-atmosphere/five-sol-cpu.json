        "extract.py": "import hashlib,json,subprocess,tarfile\nfrom pathlib import Path\nrecords=[json.loads(Path('/work/pr123/runtime-79fd84a7e4d8597593a66be67dedfe80c9eabe14.tar.json').read_text()),\n json.loads(Path('/work/pr123/69d6587cef02e5b17a82e28422b67aa3d5be55ad/source.json').read_text())]\nfor record in records:\n with Path(record['archive']).open('rb') as stream:assert hashlib.file_digest(stream,'sha256').hexdigest()==record['sha256']\n with tarfile.open(record['archive']) as handle:handle.extractall('/scratch',filter='fully_trusted')\nassert subprocess.check_output(['git','-C','/scratch/source','rev-parse','HEAD'],text=True).strip()=='69d6587cef02e5b17a82e28422b67aa3d5be55ad'\nprint('Verified prepared runtime and source overlay',flush=True)\n",
        "runner.py": "import concurrent.futures,json,os,subprocess,sys,time,resource\nfrom pathlib import Path\nimport numpy as np\nos.chdir('/scratch/source')\noutput=Path('/work/pr123/69d6587cef02e5b17a82e28422b67aa3d5be55ad/five-sol-cpu');output.mkdir(exist_ok=True)\ndef case(name):\n started=time.time()\n root=output/name\n common=[sys.executable,'scripts/run_gcm3d_ablation.py','/work/inputs','--config','reference',\n '--mola-path','/work/inputs/mars_topo_mola16.nc','--truncation','T42' if name=='T42' else 'T21',\n '--layers','56','--dt','231','--chunk-sols','1','--cooldown-seconds','0','--output-dir',str(root)]\n commands=([common+['--sols','1'],common+['--sols','5','--resume']] if name=='T21-resumed' else [common+['--sols','5']])\n with (output/(name+'.log')).open('w') as log:\n  for command in commands:\n   result=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT)\n   if result.returncode:return dict(case=name,returncode=result.returncode)\n return dict(case=name,returncode=0,started_unix=started,ended_unix=time.time(),child_max_rss_kib=resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:\n records=list(pool.map(case,['T21','T42','T21-resumed']))\n(output/'summary.json').write_text(json.dumps(records,indent=2));print(json.dumps(records),flush=True)\nif any(row['returncode'] for row in records):raise SystemExit(1)\nwith np.load(output/'T21/reference/restart.npz',allow_pickle=False) as a,np.load(output/'T21-resumed/reference/restart.npz',allow_pickle=False) as b:\n assert set(a.files)==set(b.files)\n for key in a.files:np.testing.assert_array_equal(a[key],b[key],err_msg=key)\n(output/'restart-exact.json').write_text(json.dumps(dict(revision='69d6587cef02e5b17a82e28422b67aa3d5be55ad',steps=1920,status='pass')))\n"
